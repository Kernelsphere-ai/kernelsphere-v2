# Google API Key for Gemini
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=YOUR_GEMINI_PI_KEY

# ProxyEmpire rotating residential proxy
# Set KS_PROXY_ENABLED=true to activate
KS_PROXY_ENABLED=false
KS_PROXY_HOST=YOUR_PROXY_HOST
KS_PROXY_PORT=PROXY_PORT
KS_PROXY_USERNAME=YOUR_PROXY_USERNAME
KS_PROXY_PASSWORD=YOUR_PROXY_PASSWORD
# Optional: ISO country code for geo-targeting (e.g. us, gb, de)
KS_PROXY_COUNTRY=
